<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0F1B2A">

    <LinearLayout
        android:layout_width="960dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="40dp"
        android:paddingBottom="48dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="@string/section_background"
            android:textColor="#FFFFFFFF"
            android:textSize="32sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_mode"
            style="@style/SettingsRow" />

        <Button
            android:id="@+id/btn_pick_image"
            style="@style/SettingsRow"
            android:text="@string/btn_pick_image" />

        <Button
            android:id="@+id/btn_pick_folder"
            style="@style/SettingsRow"
            android:text="@string/btn_pick_folder" />

        <Button
            android:id="@+id/btn_interval"
            style="@style/SettingsRow" />

        <Button
            android:id="@+id/btn_save"
            style="@style/SettingsRow"
            android:layout_marginTop="24dp"
            android:text="@string/btn_save" />

        <TextView
            android:id="@+id/text_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#FFB0C4D8"
            android:textSize="18sp" />
    </LinearLayout>
</ScrollView>
